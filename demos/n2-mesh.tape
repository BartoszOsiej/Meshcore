Output assets/n2-mesh-demo.svg

Set FontSize 16
Set Width 960
Set Height 420
Set Shell bash
Set MarginColor "#0d1117"
Set Theme {
  "name": "n2mesh",
  "black": "#0d1117",
  "red": "#f85149",
  "green": "#3fb950",
  "yellow": "#e3b341",
  "blue": "#58a6ff",
  "magenta": "#a371f7",
  "cyan": "#39c5cf",
  "white": "#e6edf3",
  "brightBlack": "#8b949e"
}

Type "npm install -g n2-mesh"
Enter
Sleep 1s

Type "n2-mesh --help"
Enter
Sleep 600ms

Type "n2-mesh create --room 'rust-devs'"
Enter
Sleep 1s

Type "n2-mesh join --room 'rust-devs'"
Enter
Sleep 1s

Type "# Serverless P2P chat · WebRTC · zero dependencies"
Enter
Sleep 500ms

Type "# No server · no database · no accounts"
Enter
Sleep 1s
